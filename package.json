{
  "name": "@ductura/server",
  "version": "0.1.0",
  "private": true,
  "description": "Ductura zajednički API: prijava AAI@EduHr, ovlasti, baza i pozadinski poslovi",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:property && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "test:integration": "vitest run --project integration"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/oidc-provider": "^9.13.1",
    "fast-check": "^4.10.2",
    "oidc-provider": "9.12.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
