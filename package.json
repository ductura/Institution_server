{
  "name": "@ductura/server",
  "version": "0.1.0",
  "private": true,
  "description": "Ductura zajednički API: prijava AAI@EduHr, ovlasti, baza i pozadinski poslovi",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --flag unstable_native_nodejs_ts_config -c eslint.config.ts --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:property && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "test:integration": "vitest run --project integration",
    "contracts:generate": "tsx scripts/generate-contracts.ts",
    "contracts:breaking": "tsx scripts/check-breaking.ts",
    "db:sum": "node scripts/db/migrations-ledger.ts --write",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "8.23.1",
    "dbmate": "2.36.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "^4.10.2",
    "lefthook": "2.2.2",
    "oidc-provider": "9.12.2",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "pg": "8.23.1"
  }
}
