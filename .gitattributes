# The migrations of the main database and their ledger are checked out with LF
# on every platform: db/main/migrations.sum holds the SHA-256 of the raw bytes,
# so a CRLF checkout (core.autocrlf=true on Windows) would not match it (D-91;
# as Ductus .gitattributes, "* text=auto eol=lf"). scripts/db/migrations-ledger.test.ts
# checks that every migration and the ledger get text and eol=lf.
db/main/migrations/** text eol=lf
db/main/migrations.sum text eol=lf
# The role file of the local and CI database (S-0.13), verbatim from Ductus
# db/local/migrator.sql, gets LF like the migrations.
db/main/local/** text eol=lf
# The logs database (S-1F-c, DAN-779): its migrations, ledger and local files.
db/logs/** text eol=lf
# Local stack files (S-0.14): psql reads the provisioning SQL with \if and
# \gexec, and the shell script runs inside the Linux image, where a CRLF line
# ends in "\r". scripts/db/local-files.test.ts checks the attributes and bytes.
infra/postgres/assert-pg-version.sh text eol=lf
infra/postgres/Dockerfile text eol=lf
compose.yaml text eol=lf
# Golden vectors of the evidence domain (S-0.19), verbatim from Ductus: the
# tests hash and parse their raw bytes, so a CRLF checkout would change them.
# server/domain/index.test.ts checks the attributes and bytes.
server/domain/forensics/golden-vectors/** text eol=lf
