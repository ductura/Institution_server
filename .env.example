# Copy to .env for a local run. Only names and invented local values are here;
# never put real credentials, tokens or production URLs in this file (.env is
# git-ignored). Production values are set by hand in the host dashboard
# (render.yaml, docs/DEPLOY.md). The local stack (pnpm lokalno) provisions its
# own databases and fills most of this itself (docs/LOKALNO.md).

# --- Process ---------------------------------------------------------------
# Unset means production. "development" or "test" enables the local signer and
# the fake OIDC provider; both are refused in production (D-09).
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Graceful shutdown deadline in ms (100 to 30000).
SHUTDOWN_GRACE_MS=8000
# Public origin of the browser (scheme and host only, no path).
APP_ORIGIN=http://localhost:3000
# Proxies in front of the server (addresses or CIDR); empty: X-Forwarded-For is ignored.
TRUSTED_PROXIES=
# Sampling interval of the metrics in ms (5000 to 3600000).
METRICS_INTERVAL_MS=60000
# "staging" only on the staging deployment; "test" only for the test server.
# DUCTURA_DEPLOYMENT=
# DUCTURA_MODE=

# --- Databases (logins of provisioned roles, db/*/local) --------------------
# Local-only password of the docker compose stack; not a secret.
APP_DATABASE_URL=postgres://ductus_app_local:ductus-app-local-only@127.0.0.1:54329/ductus?sslmode=disable
AUTH_DATABASE_URL=
LOGS_DATABASE_URL=
LEGAL_DATABASE_URL=
# Owner login, read by scripts and integration tests only, never by the server.
DATABASE_URL=postgres://ductus:ductus-local-only@127.0.0.1:54329/ductus?sslmode=disable

# --- Login (AAI@EduHr only; D-09) -------------------------------------------
# "aai-eduhr" in production; "fake-oidc" only locally and in CI.
DUCTUS_AUTH_PROVIDER=fake-oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Secret: set in the host dashboard, leave empty here.
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
# Optional: RS256 and 30 are the defaults.
# OIDC_ID_TOKEN_ALG=RS256
# OIDC_CLOCK_TOLERANCE_SECONDS=30

# --- Internal and evidence --------------------------------------------------
# Shared with Aplication_server, at least 32 characters. Secret: leave empty here.
DUCTURA_PROVISIONING_TOKEN=
# JSON of the storage domains; it names the EVIDENCE_S3_* variables to add by hand.
EVIDENCE_STORAGE_DOMAINS=
# Only "1" turns on protocol 2 (signed by the worker).
# DUCTUS_EVIDENCE_ASYNC_SIGNING=

# --- Optional integrations --------------------------------------------------
# DUCTURA_PDF_RENDERER_ORIGIN=
# DUCTURA_NOTIFICATION_REMINDER_INTERVAL_SECONDS=
# DUCTURA_ATTACHMENT_DIRECTORY=
# DUCTURA_STUDENT_DATA_EXPORT_DIRECTORY=
# SOURCE_LOOKUP_CONTACT=
